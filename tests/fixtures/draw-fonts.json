  "description": "Actual bold/italic, wrapping, combining/RTL and emoji graphemes on original Paragraph",
  "cases": [
    {
      "id": "draw-bold-italic",
      "group": "actual-draw-fonts",
      "width": 620,
      "height": 240,
      "mode": "default",
      "fontPolicy": "system-file-fingerprints-no-redistribution",
      "ops": [
        {
          "op": "call",
          "target": "fontLibrary",
          "name": "reset",
          "args": []
        },
        {
          "op": "set",
          "target": "ctx",
          "name": "fillStyle",
          "value": "white"
        },
        {
          "op": "call",
          "target": "ctx",
          "name": "fillRect",
          "args": [
            0,
            0,
            620,
            240
          ]
        },
        {
          "op": "set",
          "target": "ctx",
          "name": "fillStyle",
          "value": "#286bc5"
        },
        {
          "op": "set",
          "target": "ctx",
          "name": "strokeStyle",
          "value": "#285839"
        },
        {
          "op": "set",
          "target": "ctx",
          "name": "font",
          "value": "italic bold 28px sans-serif"
        },
        {
          "op": "set",
          "target": "ctx",
          "name": "textWrap",
          "value": true
        },
        {
          "op": "call",
          "target": "ctx",
          "name": "measureText",
          "args": [
            "AV ffi fj cafe\u0301",
            360
          ],
          "save": "metrics"
        },
        {
          "op": "call",
          "target": "ctx",
          "name": "fillText",
          "args": [
            "AV ffi fj cafe\u0301",
            10.25,
            60,
            360
          ]
        }
      ]
    },
